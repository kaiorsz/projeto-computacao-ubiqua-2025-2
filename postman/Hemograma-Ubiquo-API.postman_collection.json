{
  "info": {
    "name": "Hemograma Ubiquo API",
    "description": "Collection para testar a API do Sistema de Analise de Hemogramas - UFG",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081/hemograma-api",
      "type": "string"
    },
    {
      "key": "fhirUrl",
      "value": "http://localhost:8080/fhir",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "item": [
        {
          "name": "Health Check - Aplicacao",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/health",
              "host": ["{{baseUrl}}"],
              "path": ["actuator", "health"]
            },
            "description": "Verifica se a aplicacao Spring Boot esta rodando"
          }
        },
        {
          "name": "Health Check - HAPI-FHIR",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{fhirUrl}}/metadata",
              "host": ["{{fhirUrl}}"],
              "path": ["metadata"]
            },
            "description": "Verifica se o servidor HAPI-FHIR esta rodando"
          }
        }
      ]
    },
    {
      "name": "FHIR Management",
      "item": [
        {
          "name": "Criar Subscription",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/fhir-management/subscription/criar",
              "host": ["{{baseUrl}}"],
              "path": ["fhir-management", "subscription", "criar"]
            },
            "description": "Cria uma subscription no HAPI-FHIR para receber notificacoes de novos hemogramas"
          }
        },
        {
          "name": "Verificar Status Subscription",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/fhir-management/subscription/1/status",
              "host": ["{{baseUrl}}"],
              "path": ["fhir-management", "subscription", "1", "status"]
            },
            "description": "Verifica o status de uma subscription especifica"
          }
        },
        {
          "name": "Listar Subscriptions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/fhir-management/subscriptions",
              "host": ["{{baseUrl}}"],
              "path": ["fhir-management", "subscriptions"]
            },
            "description": "Lista todas as subscriptions ativas no servidor FHIR"
          }
        }
      ]
    },
    {
      "name": "HAPI-FHIR - Pacientes",
      "item": [
        {
          "name": "Criar Paciente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/fhir+json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resourceType\": \"Patient\",\n  \"name\": [\n    {\n      \"family\": \"Silva\",\n      \"given\": [\"Joao\", \"Carlos\"]\n    }\n  ],\n  \"gender\": \"male\",\n  \"birthDate\": \"1985-03-15\",\n  \"telecom\": [\n    {\n      \"system\": \"phone\",\n      \"value\": \"(62) 99999-1234\"\n    }\n  ],\n  \"address\": [\n    {\n      \"city\": \"Goiania\",\n      \"state\": \"GO\",\n      \"country\": \"Brasil\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{fhirUrl}}/Patient",
              "host": ["{{fhirUrl}}"],
              "path": ["Patient"]
            },
            "description": "Cria um novo paciente no servidor FHIR"
          }
        },
        {
          "name": "Listar Pacientes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{fhirUrl}}/Patient?_pretty=true",
              "host": ["{{fhirUrl}}"],
              "path": ["Patient"],
              "query": [
                {
                  "key": "_pretty",
                  "value": "true"
                }
              ]
            },
            "description": "Lista todos os pacientes cadastrados"
          }
        },
        {
          "name": "Buscar Paciente por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{fhirUrl}}/Patient/2?_pretty=true",
              "host": ["{{fhirUrl}}"],
              "path": ["Patient", "1"],
              "query": [
                {
                  "key": "_pretty",
                  "value": "true"
                }
              ]
            },
            "description": "Busca um paciente especifico pelo ID"
          }
        }
      ]
    },
    {
      "name": "HAPI-FHIR - Observations (Hemogramas)",
      "item": [
        {
          "name": "Criar Observation - Hemoglobina NORMAL",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/fhir+json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resourceType\": \"Observation\",\n  \"status\": \"final\",\n  \"category\": [\n    {\n      \"coding\": [\n        {\n          \"system\": \"http://terminology.hl7.org/CodeSystem/observation-category\",\n          \"code\": \"laboratory\",\n          \"display\": \"Laboratory\"\n        }\n      ]\n    }\n  ],\n  \"code\": {\n    \"coding\": [\n      {\n        \"system\": \"http://loinc.org\",\n        \"code\": \"718-7\",\n        \"display\": \"Hemoglobin [Mass/volume] in Blood\"\n      }\n    ]\n  },\n  \"subject\": {\n    \"reference\": \"Patient/2\"\n  },\n  \"effectiveDateTime\": \"2024-01-15T10:30:00Z\",\n  \"valueQuantity\": {\n    \"value\": 14.5,\n    \"unit\": \"g/dL\",\n    \"system\": \"http://unitsofmeasure.org\",\n    \"code\": \"g/dL\"\n  }\n}"
            },
            "url": {
              "raw": "{{fhirUrl}}/Observation",
              "host": ["{{fhirUrl}}"],
              "path": ["Observation"]
            },
            "description": "Cria uma observation de hemoglobina com valor NORMAL (14.5 g/dL). Referencia: 12.0 - 17.5 g/dL"
          }
        },
